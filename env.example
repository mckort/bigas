# Per-project profiles (recommended):
#   cp env.example .env.bigas-503008   # then fill in values
#   ln -sfn .env.bigas-503008 .env
#   ./deploy.sh
#   # or without symlink: ENV_FILE=.env.bigas-503008 ./deploy.sh
#   ENV_FILE=.env.bigas-503008 python scripts/sync_env_to_secret_manager.py
# Never commit .env.bigas-* (gitignored). Keep one profile per GCP project so deploys do not overwrite each other.

# Secret Manager (standalone) – keep at top so the app knows where to fetch secrets
# When SECRET_MANAGER=true and DEPLOYMENT_MODE=standalone, env vars are loaded from Google Secret Manager.
# One secret per setting: comma-separated list of secret names (each name = env var name). Payload = plain value.
# Keep GOOGLE_PROJECT_ID and GOOGLE_SERVICE_ACCOUNT_EMAIL in .env (used by deploy and for fetching secrets).
# Enable the API: gcloud services enable secretmanager.googleapis.com
# Remove any names you do not use.
SECRET_MANAGER=false
SECRET_MANAGER_SECRET_NAMES=GA4_PROPERTY_ID,OPENAI_API_KEY,GEMINI_API_KEY,LLM_MODEL,BIGAS_PROGRESS_UPDATES_MODEL,JIRA_BASE_URL,JIRA_EMAIL,JIRA_API_TOKEN,JIRA_PROJECT_KEY,JIRA_AUTOMATION_WEBHOOK_SECRET,DISCORD_WEBHOOK_URL_MARKETING,DISCORD_WEBHOOK_URL_PRODUCT,DISCORD_WEBHOOK_URL_CTO,STORAGE_BUCKET_NAME,LINKEDIN_CLIENT_ID,LINKEDIN_CLIENT_SECRET,LINKEDIN_REFRESH_TOKEN,LINKEDIN_AD_ACCOUNT_URN,REDDIT_CLIENT_ID,REDDIT_CLIENT_SECRET,REDDIT_REFRESH_TOKEN,REDDIT_AD_ACCOUNT_ID,META_ACCESS_TOKEN,META_AD_ACCOUNT_ID,GOOGLE_ADS_DEVELOPER_TOKEN,GOOGLE_ADS_CUSTOMER_ID,GOOGLE_ADS_LOGIN_CUSTOMER_ID,TARGET_KEYWORDS,GITHUB_TOKEN,CURSOR_API_KEY
GOOGLE_PROJECT_ID=your_google_cloud_project_id_here

# Google Analytics 4 Configuration
GA4_PROPERTY_ID=your_ga4_property_id_here

# LLM configuration (OpenAI and/or Gemini)
# Provider is inferred from model name (gpt-* -> OpenAI, gemini-* -> Gemini) or set BIGAS_LLM_PROVIDER=openai|gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Default model when not overridden per-feature (here set to a Gemini Pro model)
LLM_MODEL=gemini-3.1-pro-preview

# Per-feature model overrides (optional)
# BIGAS_CTO_PR_REVIEW_MODEL=gpt-4o
# BIGAS_PROGRESS_UPDATES_MODEL=gpt-4
# BIGAS_RELEASE_NOTES_MODEL=gpt-4
# BIGAS_MARKETING_LLM_MODEL=gpt-4
# BIGAS_DUPLICATE_RECOMMENDATION_MODEL=gpt-4

# Jira Cloud Configuration (for create_release_notes)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_jira_email_here
JIRA_API_TOKEN=your_jira_api_token_here
# One or more project keys (comma-separated). Example: VFA,WAYW
JIRA_PROJECT_KEY=YOURPROJECT
# Optional alias (same format). If set, takes precedence over JIRA_PROJECT_KEY.
# JIRA_PROJECT_KEYS=VFA,WAYW

# Jira AI column automation (BIG-1). See docs/jira-automation.md
JIRA_AUTOMATION_WEBHOOK_SECRET=your_shared_webhook_secret_here
# BIGAS_JIRA_AUTOMATION_ALLOWED_PROJECTS=VFA
# BIGAS_JIRA_PROJECT_REPO_MAP=VFA:mckort/vcfieldassistant,WAYW:mckort/roadpal,BIG:mckort/bigas
# BIGAS_JIRA_STATUS_DESCRIPTION_APPROVAL=Description approval (manual)
# BIGAS_JIRA_STATUS_FINAL_APPROVAL=Final approval (manual)
# BIGAS_JIRA_DEFAULT_BASE_BRANCH=main
# BIGAS_JIRA_AI_DAILY_QUOTA=20
# BIGAS_JIRA_RESEARCH_MODEL=gemini-3.1-pro-preview
# BIGAS_JIRA_DESIGN_MODEL=gemini-3.1-pro-preview
# BIGAS_JIRA_IMPLEMENT_MODEL=
# BIGAS_JIRA_IMPLEMENT_SYNC_WAIT_SECONDS=240
# BIGAS_JIRA_IMPLEMENT_MONITOR_SECONDS=900
# BIGAS_JIRA_IMPLEMENT_MONITOR_INTERVAL_SECONDS=30
# BIGAS_JIRA_ALLOW_BODY_WEBHOOK_SECRET=1

# Discord Integration
# Marketing channel (used by weekly reports, trend analysis, underperforming pages, etc.)
DISCORD_WEBHOOK_URL_MARKETING=your_marketing_discord_webhook_url_here
# Product / bigas-pm channel (release notes, progress updates, Research AI)
DISCORD_WEBHOOK_URL_PRODUCT=your_product_discord_webhook_url_here
# CTO / bigas-cto channel (PR review, Design/Implement AI). Loaded from Secret Manager when SECRET_MANAGER=true.
# DISCORD_WEBHOOK_URL_CTO=your_cto_discord_webhook_url_here

# Google Cloud Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here

# Storage Configuration (Optional - defaults to 'bigas-analytics-reports')
STORAGE_BUCKET_NAME=your_storage_bucket_name_here

# LinkedIn Ads (Optional - for paid ads reporting)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_AD_ACCOUNT_URN=your_account_id_or_urn
# Optional: LINKEDIN_VERSION=202601

# Reddit Ads (Optional - for paid ads reporting)
# Create app in Reddit Business Manager; redirect URI must match your callback, e.g. https://your-domain.com/reddit/callback
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REFRESH_TOKEN=your_reddit_refresh_token
# Optional: REDDIT_AD_ACCOUNT_ID=your_reddit_ad_account_id
# Optional: REDDIT_REDIRECT_URI (must match app; used when refreshing token). Defaults to Cloud Run callback.

# SEO Configuration (Optional - for targeted keyword analysis)
TARGET_KEYWORDS=sustainable_swag:eco_friendly_promotional_clothing:eco_friendly_swag:swag_for_remote_teams:promotional_clothing_for_distributed_teams

# CTO / PR review (Optional - for review_and_comment_pr tool)
# GitHub Personal Access Token with repo scope (read/write PR comments). Stored in Secret Manager when SECRET_MANAGER=true.
GITHUB_TOKEN=your_github_pat_here
# Cursor API key for autofix_pr (Dashboard → Integrations). Stored in Secret Manager when SECRET_MANAGER=true.
CURSOR_API_KEY=your_cursor_api_key_here
# Optional: Cursor model id for autofix (omit for Cursor default).
# BIGAS_CTO_AUTOFIX_MODEL=composer-2.5
# Optional: model for CTO PR review. Override via BIGAS_CTO_PR_REVIEW_MODEL or request body llm_model.
# BIGAS_CTO_PR_REVIEW_MODEL=gemini-3.1-pro-preview
# Optional: max diff size in characters (default 150000). Truncation note is prepended if exceeded.
# BIGAS_CTO_PR_REVIEW_MAX_DIFF_CHARS=150000
# Optional: max tokens for the generated review (default 8000). Clamp to provider limits.
# BIGAS_CTO_PR_REVIEW_MAX_TOKENS=8000

# Docker Configuration
DOCKER_REPO=your_docker_repo_name_here
IMAGE_NAME=your_image_name_here
IMAGE_TAG=latest

# Application Configuration
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000

# Testing Configuration
# Replace with your deployed Google Cloud Run URL (ends with .app)
# Example: https://your-project-name-123456789012.region.run.app
SERVER_URL=https://your-deployed-server-url.app
