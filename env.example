# Per-project profiles (recommended):
#   cp env.example .env.bigas-503008   # then fill in values
#   ln -sfn .env.bigas-503008 .env
#   ./deploy.sh
#   # or without symlink: ENV_FILE=.env.bigas-503008 ./deploy.sh
#   ENV_FILE=.env.bigas-503008 python scripts/sync_env_to_secret_manager.py
# Never commit .env.bigas-* (gitignored). Keep one profile per GCP project so deploys do not overwrite each other.

# Secret Manager (standalone) – keep at top so the app knows where to fetch secrets
# When SECRET_MANAGER=true and DEPLOYMENT_MODE=standalone, env vars are loaded from Google Secret Manager.
# One secret per setting: comma-separated list of secret names (each name = env var name). Payload = plain value.
# Keep GOOGLE_PROJECT_ID and GOOGLE_SERVICE_ACCOUNT_EMAIL in .env (used by deploy and for fetching secrets).
# Enable the API: gcloud services enable secretmanager.googleapis.com
# Remove any names you do not use.
SECRET_MANAGER=false
SECRET_MANAGER_SECRET_NAMES=GA4_PROPERTY_ID,OPENAI_API_KEY,GEMINI_API_KEY,LLM_MODEL,BIGAS_PROGRESS_UPDATES_MODEL,JIRA_BASE_URL,JIRA_EMAIL,JIRA_API_TOKEN,JIRA_PROJECT_KEY,JIRA_AUTOMATION_WEBHOOK_SECRET,DISCORD_WEBHOOK_URL_MARKETING,DISCORD_WEBHOOK_URL_PRODUCT,DISCORD_WEBHOOK_URL_CTO,STORAGE_BUCKET_NAME,LINKEDIN_CLIENT_ID,LINKEDIN_CLIENT_SECRET,LINKEDIN_REFRESH_TOKEN,LINKEDIN_AD_ACCOUNT_URN,REDDIT_CLIENT_ID,REDDIT_CLIENT_SECRET,REDDIT_REFRESH_TOKEN,REDDIT_AD_ACCOUNT_ID,META_ACCESS_TOKEN,META_AD_ACCOUNT_ID,GOOGLE_ADS_DEVELOPER_TOKEN,GOOGLE_ADS_CUSTOMER_ID,GOOGLE_ADS_LOGIN_CUSTOMER_ID,TARGET_KEYWORDS,GITHUB_TOKEN,CURSOR_API_KEY,MONITOR_URLS,X_ACCOUNTS,X_API_KEY,X_API_SECRET,X_CREDENTIALS_JSON,X_POST_SIGNING_SECRET,X_ACCESS_TOKEN_BIGASMYAITEAM,X_ACCESS_SECRET_BIGASMYAITEAM,X_API_KEY_VCFIELDASSISAN,X_API_SECRET_VCFIELDASSISAN,X_ACCESS_TOKEN_VCFIELDASSISAN,X_ACCESS_SECRET_VCFIELDASSISAN,BIGAS_EMAIL_IMAP_SERVER,BIGAS_EMAIL_USERNAME,BIGAS_EMAIL_PASSWORD
GOOGLE_PROJECT_ID=your_google_cloud_project_id_here

# Google Analytics 4 Configuration
GA4_PROPERTY_ID=your_ga4_property_id_here
# Optional: map Jira project keys (or hostnames) to GA4 property IDs.
# Unmapped projects error instead of querying another brand's property.
# Example: GPWW:473559548,VFA:123456789
# BIGAS_GA4_PROPERTY_MAP=GPWW:your_ga4_property_id_here

# LLM configuration (OpenAI and/or Gemini)
# Provider is inferred from model name (gpt-* -> OpenAI, gemini-* -> Gemini) or set BIGAS_LLM_PROVIDER=openai|gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Default model when not overridden per-feature (here set to a Gemini Pro model)
LLM_MODEL=gemini-3.1-pro-preview

# Per-feature model overrides (optional)
# BIGAS_CTO_PR_REVIEW_MODEL=gpt-4o
# BIGAS_PROGRESS_UPDATES_MODEL=gpt-4
# BIGAS_RELEASE_NOTES_MODEL=gpt-4
# BIGAS_MARKETING_LLM_MODEL=gpt-4
# BIGAS_DUPLICATE_RECOMMENDATION_MODEL=gpt-4

# Jira Cloud Configuration (optional — omit to use the native Kanban board at /board)
# USE_INTERNAL_BOARD=true   # default when Jira vars are unset; set false to require Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_jira_email_here
JIRA_API_TOKEN=your_jira_api_token_here
# One or more project keys (comma-separated). Chat, Jira tools, and GA4 routing use this list.
# Example: VFA,WAYW,BIG,REM,GPWW,FYDA,MYL
JIRA_PROJECT_KEY=YOURPROJECT
# Optional alias (same format). If set, takes precedence over JIRA_PROJECT_KEY.
# JIRA_PROJECT_KEYS=VFA,WAYW
# JIRA_CTO_PROJECT_KEY=BIG
# JIRA_PM_PROJECT_KEY=BIG

# Jira AI column automation (BIG-1). See docs/jira-automation.md
JIRA_AUTOMATION_WEBHOOK_SECRET=your_shared_webhook_secret_here
# BIGAS_JIRA_AUTOMATION_ALLOWED_PROJECTS=VFA
# BIGAS_JIRA_PROJECT_REPO_MAP=VFA:mckort/vcfieldassistant,WAYW:mckort/roadpal,BIG:mckort/bigas,REM:mckort/remotebrief,GPWW:Green-Promo-Wear-Global/greenpromowear-website,FYDA:mckort/fulfillyourdreamadventure,MYL:mckort/mylifesdeed
# BIGAS_JIRA_REPO_BASE_BRANCH_MAP=mckort/fulfillyourdreamadventure:master,mckort/vcfieldassistant:main
# BIGAS_JIRA_STATUS_DESCRIPTION_APPROVAL=Description approval (manual)
# BIGAS_JIRA_STATUS_FINAL_APPROVAL=Final approval (manual)
# BIGAS_JIRA_DEFAULT_BASE_BRANCH=main
# BIGAS_JIRA_AI_DAILY_QUOTA=20
# BIGAS_JIRA_RESEARCH_MODEL=gemini-3.1-pro-preview
# BIGAS_JIRA_DESIGN_MODEL=gemini-3.1-pro-preview
# BIGAS_JIRA_IMPLEMENT_MODEL=
# BIGAS_JIRA_IMPLEMENT_SYNC_WAIT_SECONDS=240
# BIGAS_JIRA_IMPLEMENT_MONITOR_SECONDS=900
# BIGAS_JIRA_IMPLEMENT_MONITOR_INTERVAL_SECONDS=30
# BIGAS_JIRA_ALLOW_BODY_WEBHOOK_SECRET=1

# Proactive Goal Engine (BIG-12): Epics as goals + scheduled evaluate-goals webhook
# Reads internal /board Epics when USE_INTERNAL_BOARD=true (or Jira is unset).
# Always requires auth: X-Bigas-Access-Key / Authorization Bearer (BIGAS_ACCESS_KEY),
# or legacy CRON_SECRET via Bearer / X-Cron-Secret for backwards-compatible schedulers.
# CRON_SECRET=your_cloud_scheduler_shared_secret
# BIGAS_GOAL_EPIC_STATUSES=Research,Plan,In Progress
# BIGAS_GOAL_DEFAULT_TIMEFRAME_DAYS=7
# JIRA_EPIC_LINK_FIELD=parent
# JIRA_EPIC_JQL_FIELD=parent
# For company-managed Jira boards, use Epic Link instead:
# JIRA_EPIC_LINK_FIELD=customfield_10014
# JIRA_EPIC_JQL_FIELD=Epic Link
# DISCORD_WEBHOOK_URL_CHIEF=your_chief_of_staff_discord_webhook_url_here
# BIGAS_PROACTIVE_GOALS_MODEL=gemini-3.1-pro-preview
# Monday OKR pulse (mechanical counts → Chief chat). Optional LLM comment underneath.
# BIGAS_OKR_STALE_DAYS=7
# BIGAS_OKR_PULSE_MODEL=gemini-3.1-pro-preview

# Discord Integration
# Marketing channel (used by weekly reports, trend analysis, underperforming pages, etc.)
DISCORD_WEBHOOK_URL_MARKETING=your_marketing_discord_webhook_url_here
# Product / bigas-pm channel (release notes, progress updates, Research AI, QA new-feature issues)
DISCORD_WEBHOOK_URL_PRODUCT=your_product_discord_webhook_url_here
# CTO / bigas-cto channel (PR review, Design/Implement AI, QA improvement proposals)
# DISCORD_WEBHOOK_URL_CTO=your_cto_discord_webhook_url_here
# QA channel (brief pass/fail summaries after automated MCP QA runs)
# DISCORD_WEBHOOK_URL_QA=your_qa_discord_webhook_url_here

# Google Cloud Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here

# Storage Configuration (Optional - defaults to 'bigas-analytics-reports')
STORAGE_BUCKET_NAME=your_storage_bucket_name_here

# LinkedIn Ads (Optional - for paid ads reporting)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_AD_ACCOUNT_URN=your_account_id_or_urn
# Optional: LINKEDIN_VERSION=202601

# Reddit Ads (Optional - for paid ads reporting)
# Create app in Reddit Business Manager; redirect URI must match your callback, e.g. https://your-domain.com/reddit/callback
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REFRESH_TOKEN=your_reddit_refresh_token
# Optional: REDDIT_AD_ACCOUNT_ID=your_reddit_ad_account_id
# Optional: REDDIT_REDIRECT_URI (must match app; used when refreshing token). Defaults to Cloud Run callback.

# SEO Configuration (Optional - for targeted keyword analysis)
TARGET_KEYWORDS=sustainable_swag:eco_friendly_promotional_clothing:eco_friendly_swag:swag_for_remote_teams:promotional_clothing_for_distributed_teams

# Website Monitoring (Optional - for availability and SSL certificate checks)
# Comma-separated list of URLs to monitor (e.g., https://site1.com,https://site2.com)
# Trigger via Cloud Scheduler with POST /mcp/tools/website_monitor
MONITOR_URLS=

# X / Twitter posting (Optional - weekly community updates with Discord approval)
# Discord approval links use SERVER_URL (deployed to Cloud Run by deploy.sh).
# Optional override: BIGAS_PUBLIC_URL=https://your-service-url.a.run.app
# Signing secret for Approve/Decline links. Falls back to JIRA_AUTOMATION_WEBHOOK_SECRET.
# X_POST_SIGNING_SECRET=your_random_signing_secret
# Comma-separated X handles to publish to.
# X_ACCOUNTS=bigasmyaiteam,vcfieldassistan
# Recommended for Secret Manager: one JSON secret with all account credentials.
# X_CREDENTIALS_JSON={"bigasmyaiteam":{"api_key":"...","api_secret":"...","access_token":"...","access_secret":"..."}}
# Alternative: shared or per-account app keys + per-account user tokens
# X_API_KEY=your_oauth1_consumer_key
# X_API_SECRET=your_oauth1_consumer_secret
# X_ACCESS_TOKEN_BIGASMYAITEAM=your_user_access_token
# X_ACCESS_SECRET_BIGASMYAITEAM=your_user_access_token_secret
# Second account (own X app): suffix is the handle in uppercase.
# X_API_KEY_VCFIELDASSISAN=your_oauth1_consumer_key
# X_API_SECRET_VCFIELDASSISAN=your_oauth1_consumer_secret
# X_ACCESS_TOKEN_VCFIELDASSISAN=your_user_access_token
# X_ACCESS_SECRET_VCFIELDASSISAN=your_user_access_token_secret
# Optional: X_POST_DRAFT_TTL_HOURS=48
# Optional: BIGAS_X_POSTS_MODEL=gemini-3.1-pro-preview

# Automated MCP QA (BIG-5)
# QA_PROPOSAL_SIGNING_SECRET=your_random_signing_secret
# Optional alias for signing Approve/Decline links (falls back to JIRA_AUTOMATION_WEBHOOK_SECRET)
# QA_PROPOSAL_TTL_HOURS=72
# BIGAS_QA_AGENT_MODEL=gemini-3.1-pro-preview

# CTO / PR review (Optional - for review_and_comment_pr tool)
# GitHub Personal Access Token with repo scope (read/write PR comments). Stored in Secret Manager when SECRET_MANAGER=true.
# DevOps deployment tools also need Actions access (actions:write on fine-grained PAT, or classic repo scope with Actions).
GITHUB_TOKEN=your_github_pat_here
# GitHub webhook secret for self-healing CI (workflow_run events). Falls back to JIRA_AUTOMATION_WEBHOOK_SECRET.
# GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Enable autonomous hotfix PRs when GitHub Actions fail (default true).
# ENABLE_SELF_HEALING_CI=true
# Max workflow run log zip download size in bytes (default 52428800 = 50 MB).
# BIGAS_CI_LOG_ZIP_MAX_BYTES=52428800
# DevOps: map Jira project keys to GitHub Actions workflow filenames (pipe-separated projects).
# VFA uses deploy-backend.yml + deploy-web.yml on its product repo.
# GPWW/FYDA/REM/MYL dispatch deploy.yml on the VM infra repo (see BIGAS_DEPLOY_REPO_MAP).
# BIGAS_DEPLOY_WORKFLOW_MAP=VFA:deploy-backend.yml,deploy-web.yml|GPWW:deploy.yml|FYDA:deploy.yml|REM:deploy.yml|MYL:deploy.yml
# Optional: dispatch workflows on a different repo than BIGAS_JIRA_PROJECT_REPO_MAP (CSV).
# BIGAS_DEPLOY_REPO_MAP=GPWW:mckort/gcp-single-vm-webstack,FYDA:mckort/gcp-single-vm-webstack,REM:mckort/gcp-single-vm-webstack,MYL:mckort/gcp-single-vm-webstack
# Cursor API key for autofix_pr (Dashboard → Integrations). Stored in Secret Manager when SECRET_MANAGER=true.
CURSOR_API_KEY=your_cursor_api_key_here
# Cost rollups (fetch_ai_usage / weekly CFO report). Comma-separated provider names.
# Omit or empty = no usage sources (report still runs). Built-in: cursor, llm_logs, gcp_billing, tavily.
# BIGAS_USAGE_PROVIDERS=cursor,llm_logs,gcp_billing,tavily
# Optional: extra Cloud Logging filter for llm_logs usage provider (weekly AI report).
# BIGAS_CTO_USAGE_LOG_FILTER=
# BigQuery dataset for Cloud Billing export (gcp_billing provider). Table is auto-detected.
# BIGAS_GCP_BILLING_DATASET=gcp_billing
# BIGAS_BILLING_ACCOUNT=011097-9C6611-22F8ED
# Firestore project for Tavily list-price (tavily provider). Default vcfieldassistant.
# BIGAS_TAVILY_USAGE_PROJECT=vcfieldassistant
# Cursor model id for autofix. Prefer standard composer-2.5 (~6x cheaper than
# composer-2.5-fast; Cursor's product default is often fast). Omit = Cursor default.
BIGAS_CTO_AUTOFIX_MODEL=composer-2.5
# BIGAS_CTO_AUTOFIX_MAX_ITERATIONS=5
# BIGAS_CTO_AUTOFIX_COOLDOWN_SECONDS=600
# Squash-merge the PR when review has no Blockers/Important (default false).
# If required checks block immediate merge, enables GitHub native auto-merge.
# Requires GITHUB_TOKEN with permission to merge + repo "Allow auto-merge".
# BIGAS_CTO_AUTO_MERGE=false
# Optional: model for CTO PR review. Override via BIGAS_CTO_PR_REVIEW_MODEL or request body llm_model.
# BIGAS_CTO_PR_REVIEW_MODEL=gemini-pro-latest
# Optional: max diff size in characters (default 150000). Truncation note is prepended if exceeded.
# BIGAS_CTO_PR_REVIEW_MAX_DIFF_CHARS=150000
# Optional: max tokens for the generated review (default 8000). Clamp to provider limits.
# BIGAS_CTO_PR_REVIEW_MAX_TOKENS=12000

# Docker Configuration
DOCKER_REPO=your_docker_repo_name_here
IMAGE_NAME=your_image_name_here
IMAGE_TAG=latest

# Application Configuration
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000

# Public Cloud Run URL (tests + Discord X-post approval links). deploy.sh sends this to Cloud Run.
# Example: https://your-project-name-123456789012.region.run.app
SERVER_URL=https://your-deployed-server-url.app

# Chat web interface (BIG-6)
CHAT_ENABLED=true
# Storage: "memory" for local dev/tests, "firestore" for production (default when FIREBASE_PROJECT_ID is set)
CHAT_STORAGE_MODE=memory
# Auth: "dev" uses CHAT_DEV_TOKEN; "firebase" verifies Firebase ID tokens
CHAT_AUTH_MODE=dev
CHAT_DEV_TOKEN=bigas-dev-token
# Comma-separated emails allowed to use chat when CHAT_AUTH_MODE=firebase.
# Falls back to CHAT_ADMIN_EMAILS if unset. Leave both empty to allow any Firebase user.
# CHAT_ALLOWED_EMAILS=you@example.com
# Comma-separated emails allowed to PUT /api/agents/* (defaults to dev@bigas.local when CHAT_AUTH_MODE=dev)
# CHAT_ADMIN_EMAILS=you@example.com,admin@example.com
# Shared secret for sub-agent async callbacks (defaults to first BIGAS_ACCESS_KEYS entry)
# CHAT_CALLBACK_SECRET=your_callback_secret
# Firebase / Firestore (production)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_WEB_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: inline service account JSON for Firebase Admin (otherwise uses ADC on Cloud Run)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional: dedicated model for chat / Chief of Staff
# BIGAS_CHAT_MODEL=gemini-3.1-pro-preview

# Email ingest (BIG-9) — Chief of Staff inbox via IMAP (e.g. Migadu cos@bigas.me)
# Required IMAP creds belong in Secret Manager (add to SECRET_MANAGER_SECRET_NAMES).
# Same username/password are used to send replies via SMTP.
# BIGAS_EMAIL_IMAP_SERVER=imap.migadu.com
# BIGAS_EMAIL_IMAP_PORT=993
# BIGAS_EMAIL_USERNAME=cos@bigas.me
# BIGAS_EMAIL_PASSWORD=your_imap_password
# BIGAS_EMAIL_IMAP_MAILBOX=INBOX
# Optional SMTP (defaults: smtp.migadu.com:465)
# BIGAS_EMAIL_SMTP_SERVER=smtp.migadu.com
# BIGAS_EMAIL_SMTP_PORT=465
# Optional: move processed mail instead of marking read
# BIGAS_EMAIL_PROCESSED_FOLDER=Processed
# Max plain-text body chars passed to the COS LLM (default 8000)
# BIGAS_EMAIL_MAX_BODY_CHARS=8000
# Chat user that receives overnight email triage (defaults to first CHAT_ADMIN_EMAILS)
# BIGAS_EMAIL_SYNC_USER_EMAIL=you@example.com
# BIGAS_EMAIL_SYNC_USER_UID=firebase_uid_override
